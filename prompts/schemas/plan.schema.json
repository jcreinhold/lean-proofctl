{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kan-prover.local/schemas/theorem-plan-v1.json",
  "title": "TheoremPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "strategy", "steps"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "title", "goal", "rationale"],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "helper_suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieval_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "helper_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
